# Copy this file to `.env` and fill it in.
#
# `.env` is where the real values live. It is listed in .gitignore and never
# leaves your machine except as the cloud name, which is public by design.

# The Cloudinary cloud name. Public — it appears in every delivery URL, so it
# is the only one of these the browser is allowed to see.
VITE_CLOUDINARY_CLOUD_NAME=

# The API key and secret. Server-side only: `scripts/upload-cloudinary.mjs`
# reads them and signs its requests. Vite does not expose them to the
# frontend, because only variables prefixed with VITE_ are ever sent to the
# browser.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The upload preset used to put the photographs into the cloud. An unsigned
# preset needs no key and no signature — the preset name is the permission.
# Leave it empty to sign the upload with the key and secret above instead.
CLOUDINARY_UPLOAD_PRESET=

# The same preset, in the form the browser build reads. An unsigned preset is
# public by design — the preset name *is* the permission, so it is meant to
# be in the browser. It is what lets a visitor offer a photograph of a
# landmark, uploaded straight from their browser to Cloudinary. Leave it empty
# to hide the offer-a-photograph control.
VITE_CLOUDINARY_UPLOAD_PRESET=
